[
  {
    "id": "LabPgCred0000001",
    "name": "Reliability Lab Postgres",
    "type": "postgres",
    "data": {
      "host": "postgres",
      "port": 5432,
      "database": "${LAB_DB_NAME}",
      "user": "${LAB_DB_USER}",
      "password": "${LAB_DB_PASSWORD}",
      "ssl": "disable"
    }
  },
  {
    "id": "LabOpsCred000001",
    "name": "Reliability Lab Operator Header",
    "type": "httpHeaderAuth",
    "data": {
      "name": "${LAB_OPERATOR_HEADER_NAME}",
      "value": "${LAB_OPERATOR_HEADER_VALUE}"
    }
  }
]
