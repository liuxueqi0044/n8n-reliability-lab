N8N_VERSION=2.32.7
N8N_HOST_PORT=5678
POSTGRES_HOST_PORT=5432
WIREMOCK_HOST_PORT=8080

POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres_local_only
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=n8n_local_only
LAB_DB_NAME=reliability_lab
LAB_DB_USER=reliability_app
LAB_DB_PASSWORD=lab_local_only

N8N_ENCRYPTION_KEY=replace-with-a-random-local-key
N8N_INSTANCE_OWNER_EMAIL=owner@example.local
N8N_INSTANCE_OWNER_FIRST_NAME=Reliability
N8N_INSTANCE_OWNER_LAST_NAME=Lab
# Local-only demo login password: reliability_lab_local_only. This is not a production secret.
N8N_INSTANCE_OWNER_PASSWORD_HASH='$2b$12$O4ZmEGCEUC8jxdflpPBX0uYrhaZpS70EiWEMzjS7Glkfj1WMLGnC6'

LAB_OPERATOR_HEADER_NAME=x-lab-operator-key
LAB_OPERATOR_HEADER_VALUE=operator_local_only
GENERIC_TIMEZONE=UTC
TZ=UTC
