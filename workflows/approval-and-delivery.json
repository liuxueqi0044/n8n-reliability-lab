    { "parameters": { "httpMethod": "POST", "path": "lead-approval", "authentication": "headerAuth", "responseMode": "responseNode", "options": {} }, "id": "ApprovalWebhook0001", "name": "Webhook - Lead Approval", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [0, 300], "webhookId": "ApprovalWebhook0001", "credentials": { "httpHeaderAuth": { "id": "LabOpsCred000001", "name": "Reliability Lab Operator Header" } } },
    { "parameters": { "jsCode": "const input = $input.first()?.json ?? {}; const body = Object.prototype.hasOwnProperty.call(input, 'body') ? input.body : input; const errors = []; const add = (field, code, message) => errors.push({ field, code, message }); const eventId = typeof body?.event_id === 'string' ? body.event_id.trim() : ''; if (!eventId) add('event_id', body?.event_id == null ? 'required' : 'invalid_type', body?.event_id == null ? 'event_id is required' : 'event_id must be a string'); else if (eventId.length > 128) add('event_id', 'too_long', 'event_id must be at most 128 characters'); const decision = typeof body?.decision === 'string' ? body.decision.trim() : ''; if (!decision) add('decision', body?.decision == null ? 'required' : 'invalid_type', body?.decision == null ? 'decision is required' : 'decision must be a string'); else if (!['approved', 'rejected'].includes(decision)) add('decision', 'invalid_format', 'decision must be approved or rejected'); const decidedBy = typeof body?.decided_by === 'string' ? body.decided_by.trim() : ''; if (!decidedBy) add('decided_by', body?.decided_by == null ? 'required' : 'invalid_type', body?.decided_by == null ? 'decided_by is required' : 'decided_by must be a string'); else if (decidedBy.length > 200) add('decided_by', 'too_long', 'decided_by must be at most 200 characters'); let reason = null; if (body?.reason != null && typeof body.reason !== 'string') add('reason', 'invalid_type', 'reason must be a string'); else if (typeof body?.reason === 'string') { reason = body.reason.trim(); if (reason.length > 2000) add('reason', 'too_long', 'reason must be at most 2000 characters'); } return [{ json: { event_id: eventId || null, decision: decision || null, decided_by: decidedBy || null, reason, errors, valid: errors.length === 0, entry: 'approval_webhook' } }];" }, "id": "ApprovalValidate0001", "name": "Validate Approval Body", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [240, 300] },
    { "parameters": { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 }, "conditions": [{ "leftValue": "={{ $json.valid }}", "rightValue": true, "operator": { "type": "boolean", "operation": "equals" } }], "combinator": "and" } }, "id": "ApprovalValid0001", "name": "Approval Body Valid?", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [480, 300] },
