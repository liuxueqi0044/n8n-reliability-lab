    { "parameters": { "jsCode": "const attempt = Number($json.attempt_no ?? 0) + 1; if (attempt > 3) throw new Error('retry attempt exceeded'); const source = $json.request_payload?.source; const crmPath = source === 'wiremock-transient' ? '/crm/leads/transient' : source === 'wiremock-permanent' ? '/crm/leads/permanent' : source === 'wiremock-nonretryable' ? '/crm/leads/nonretryable' : source === 'wiremock-recoverable' ? '/crm/leads/recoverable' : '/crm/leads/success'; return [{ json: { ...$json, attempt_no: attempt, crm_path: crmPath, idempotency_key: String($json.event_id) } }];" }, "id": "DeliveryRequest0001", "name": "Build CRM Request", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1920, -80] },
