    { "parameters": { "resource": "database", "operation": "executeQuery", "query": "select r.*, $10::integer as attempt_no, $11::jsonb as request_payload, $12::text as entry, $13::text as event_id, $14::integer as processing_cycle from record_delivery_attempt($1::text, $2::integer, $3::integer, $4::integer, $5::jsonb, $6::text, $7::text, $8::text, $9::text) r", "options": { "queryReplacement": "={{ [ $('Build CRM Request').item.json.event_id, $('Build CRM Request').item.json.processing_cycle, $('Build CRM Request').item.json.attempt_no, $json.statusCode ?? null, JSON.stringify($('Build CRM Request').item.json.request_payload), JSON.stringify($json.body || $json).slice(0, 2000), $json.statusCode >= 400 ? JSON.stringify($json.body || $json).slice(0, 2000) : null, 'Approval and Delivery', String($execution.id), $('Build CRM Request').item.json.attempt_no, JSON.stringify($('Build CRM Request').item.json.request_payload), $('Build CRM Request').item.json.entry, $('Build CRM Request').item.json.event_id, $('Build CRM Request').item.json.processing_cycle ] }}" } }, "id": "DeliveryRecord0001", "name": "Record Delivery Attempt", "type": "n8n-nodes-base.postgres", "typeVersion": 2.6, "position": [2400, -80], "credentials": { "postgres": { "id": "LabPgCred0000001", "name": "Reliability Lab Postgres" } } },
